{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Main window: every app command (it is the full UI), event listening and the window controls of its own title bar (drag, resize, minimize, maximize, close). No other core APIs.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-start-dragging",
    "core:window:allow-start-resize-dragging",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-is-maximized",
    "core:window:allow-minimize",
    "core:window:allow-close",
    "core:window:allow-set-theme",
    "allow-app-status",
    "allow-get-settings",
    "allow-update-settings",
    "allow-choose-download-folder",
    "allow-open-download-folder",
    "allow-save-log",
    "allow-open-release-notes",
    "allow-list-sites",
    "allow-create-site",
    "allow-update-site",
    "allow-delete-site",
    "allow-duplicate-site",
    "allow-reorder-sites",
    "allow-choose-key-file",
    "allow-forget-host-key",
    "allow-import-ssh-config",
    "allow-import-filezilla",
    "allow-export-sites",
    "allow-import-sites-file",
    "allow-connect",
    "allow-test-connection",
    "allow-trust-host-key",
    "allow-disconnect",
    "allow-reconnect",
    "allow-list-dir",
    "allow-stat-path",
    "allow-make-dir",
    "allow-make-file",
    "allow-rename-path",
    "allow-delete-paths",
    "allow-chmod-path",
    "allow-open-file",
    "allow-read-more",
    "allow-save-file",
    "allow-download-paths",
    "allow-upload-files",
    "allow-upload-dropped",
    "allow-cancel-transfer",
    "allow-retry-transfer",
    "allow-clear-transfers",
    "allow-resolve-conflict",
    "allow-list-snippets",
    "allow-create-snippet",
    "allow-update-snippet",
    "allow-delete-snippet",
    "allow-reorder-snippets",
    "allow-run-command",
    "allow-cancel-command"
  ]
}
