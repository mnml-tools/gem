{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gem",
  "mainBinaryName": "gem",
  "version": "0.1.0",
  "identifier": "app.gem.Gem",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1426",
    "beforeBuildCommand": "pnpm build && node scripts/third-party-licenses.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost ws://localhost:1426",
        "object-src": "'none'",
        "base-uri": "'none'",
        "frame-ancestors": "'none'",
        "form-action": "'none'"
      },
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Minimal remote file manager for SFTP, FTP and FTPS.",
    "longDescription": "Gem browses servers over SFTP, FTP and FTPS in tabs, shows remote files with syntax highlighting without downloading them, lets you edit and save them back safely, and keeps the connection log at hand.",
    "copyright": "© 2026 Gem contributors",
    "license": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "resources": {
      "resources/THIRD_PARTY_LICENSES.md": "THIRD_PARTY_LICENSES.md"
    }
  }
}
