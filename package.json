{
  "name": "gem",
  "version": "0.1.0",
  "private": true,
  "description": "Minimal remote file manager for SFTP, FTP and FTPS, with an in-place file viewer and editor.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "packageManager": "pnpm@11.26.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "rust:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml --all -- --check",
    "rust:lint": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --locked -- -D warnings",
    "rust:test": "cargo test --manifest-path src-tauri/Cargo.toml --locked",
    "rust:check": "pnpm rust:fmt && pnpm rust:lint && pnpm rust:test",
    "rust:it": "GEM_IT=1 cargo test --manifest-path src-tauri/Cargo.toml --locked remote::it -- --test-threads=4 --nocapture && GEM_IT=1 cargo test --manifest-path src-tauri/Cargo.toml --locked services::it -- --test-threads=4 --nocapture",
    "bindings": "cargo test --manifest-path src-tauri/Cargo.toml --locked export_bindings",
    "servers:up": "docker compose -f dev/servers/docker-compose.yml up -d --build --wait",
    "servers:down": "docker compose -f dev/servers/docker-compose.yml down -v",
    "verify": "pnpm check && pnpm rust:check && pnpm build",
    "icons": "node scripts/build-icons.mjs",
    "icons:png": "tauri icon src/assets/AppIcon.png",
    "icons:mac": "node scripts/build-macos-icon.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-go": "6.0.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-php": "6.0.2",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/lang-rust": "6.0.2",
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/lang-xml": "6.1.0",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.13.1",
    "@codemirror/legacy-modes": "6.5.5",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5",
    "@mnml-tools/ui": "0.1.0",
    "@tanstack/react-query": "5.106.1",
    "@tauri-apps/api": "2.12.4",
    "lucide-react": "1.70.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tauri-apps/cli": "2.12.4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "10.14.0",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.14.0",
    "jsdom": "31.0.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
